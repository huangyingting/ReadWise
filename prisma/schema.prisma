generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  Admin
  Reader
  Moderator
  ContentEditor
  SupportAgent
}

enum ArticleVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
  ORG
}

enum ArticleStatus {
  DRAFT      @map("draft")
  PROCESSING @map("processing")
  PUBLISHED  @map("published")
  FAILED     @map("failed")
  ARCHIVED   @map("archived")
}

enum ArticleSourceType {
  SCRAPED
  IMPORTED
  MANUAL
  RSS
  ASSIGNMENT
}

enum TagScope {
  PUBLIC
  PRIVATE
  ORG
}

enum JobType {
  ARTICLE_INGEST
  ARTICLE_PROCESS
  AI_REBUILD
  TTS_GENERATE
  PUSH_REMINDER
}

enum JobStatus {
  PENDING
  CLAIMED
  RUNNING
  COMPLETED
  FAILED
  DEAD_LETTER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(Reader)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts              Account[]
  sessions              Session[]
  profile               Profile?
  readingProgress       ReadingProgress[]
  savedWords            SavedWord[]
  dailyActivities       DailyActivity[]
  levelHistory          LevelHistory[]
  readingLists          ReadingList[]
  highlights            Highlight[]
  tutorMessages         TutorMessage[]
  quizAttempts          QuizAttempt[]
  pronunciationAttempts PronunciationAttempt[]
  pushSubscriptions       PushSubscription[]
  difficultyFeedback      ArticleDifficultyFeedback[]
  ownedArticles           Article[]                   @relation("OwnedArticles")
  ownedTags               Tag[]                       @relation("OwnedTags")
  wordMastery             WordMastery[]
  articleMastery          ArticleMastery[]
  skillMastery            SkillMastery[]
  reminderPreference      ReminderPreference?
  memberships             Membership[]
  taughtClassrooms        Classroom[]                 @relation("TaughtClassrooms")
  classroomMemberships    ClassroomMembership[]
  assignmentCompletions   AssignmentCompletion[]
  assignmentTargets       AssignmentTarget[]
  todaySessions           TodaySession[]
  placementResult            PlacementResult?
  todayComprehensionFeedback TodayComprehensionFeedback[]
  learnerCoachMemories       LearnerCoachMemory[]
  studyPlanSnapshots         StudyPlanSnapshot[]
  seriesEnrollments          SeriesEnrollment[]

  @@index([role, createdAt], map: "User_role_created_idx")
}

model Profile {
  id              String    @id @default(cuid())
  userId          String    @unique
  ageRange        String?
  gender          String?
  englishLevel    String
  topics          Json      @default("[]")
  completedAt     DateTime?
  dailyGoal       Int       @default(2)
  timezone        String?
  goalPath        String?   // controlled: "daily_news" | "academic" | "business" | "exam" | "extensive" | null
  streakShields   Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Article {
  id              String    @id @default(cuid())
  slug            String?   @unique
  title           String
  author          String?
  source          String?
  sourceUrl       String?
  heroImage       String?
  excerpt         String?
  content         String
  category        String?
  wordCount       Int?
  readingMinutes  Int?
  difficulty      String?
  difficultyScore Float?
  lexileApprox    Int?
  difficultyVersion String?
  visibility      ArticleVisibility @default(PUBLIC)
  status          ArticleStatus     @default(PUBLISHED)
  sourceType      ArticleSourceType @default(SCRAPED)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  /// Nullable FK to User. Public library articles are explicit (`visibility = PUBLIC`);
  /// private imports use `visibility = PRIVATE` plus a non-null ownerId.
  ownerId         String?
  /// Content rights & takedown (RW-047). `canonicalUrl` records the upstream
  /// canonical link; `takedownState` is one of active/unpublished/archived/takedown;
  /// `rightsNote` holds a free-text licensing/usage note. `reviewState` and
  /// `qualityFlags` (RW-048) drive the moderation workflow.
  canonicalUrl    String?
  takedownState   String            @default("active")
  rightsNote      String?
  reviewState     String            @default("unreviewed")
  qualityFlags    Json              @default("[]")
  /// Nullable SOFT tenant-scope reference (RW-060). NOT a foreign key — mirrors the
  /// AnalyticsEvent/AuditLog plain-string ref convention so existing global/public
  /// articles are unaffected (null = global/public, never appears in org feeds) and
  /// deleting an Organization never rebuilds this table. Org/tenant feeds filter on it.
  organizationId  String?

  owner                User?                 @relation("OwnedArticles", fields: [ownerId], references: [id], onDelete: Cascade)
  readingProgress      ReadingProgress[]
  translations         Translation[]
  sentenceTranslations SentenceTranslation[]
  vocabulary           VocabularyItem[]
  quizQuestions        QuizQuestion[]
  quizAttempts         QuizAttempt[]
  speech               ArticleSpeech?
  tags                 ArticleTag[]
  readingListItems     ReadingListItem[]
  highlights           Highlight[]
  tutorMessages        TutorMessage[]
  pronunciationAttempts     PronunciationAttempt[]
  difficultyFeedback        ArticleDifficultyFeedback[]
  grammarExplanations       GrammarExplanation[]
  processingSteps           ArticleProcessingStep[]
  articleMastery            ArticleMastery[]
  reviews                   ContentReview[]
  mediaAssets               MediaAsset[]
  assignments               Assignment[]
  contentReports            ContentReport[]
  crawlCandidates           CrawlCandidate[]
  contentVersions           ArticleContentVersion[]

  @@unique([sourceUrl, ownerId])
  @@index([category])
  @@index([ownerId])
  @@index([organizationId])
  @@index([sourceUrl], map: "Article_sourceUrl_idx")
  @@index([visibility, status, ownerId, publishedAt, createdAt], map: "Article_visibility_feed_idx")
  @@index([visibility, status, ownerId, category, publishedAt, createdAt], map: "Article_category_feed_idx")
  @@index([ownerId, status, createdAt], map: "Article_owner_status_created_idx")
  @@index([status, createdAt], map: "Article_status_created_idx")
  @@index([visibility, status, ownerId, difficulty, difficultyScore, publishedAt], map: "Article_level_feed_idx")
  @@index([takedownState])
  @@index([reviewState])
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  slug      String
  scope     TagScope @default(PUBLIC)
  /// Stable non-null namespace for uniqueness: "public" for global tags,
  /// "user:<id>" for private tags, and future "org:<id>".
  namespace String   @default("public")
  ownerId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User?        @relation("OwnedTags", fields: [ownerId], references: [id], onDelete: Cascade)
  articles ArticleTag[]

  @@unique([scope, namespace, slug])
  @@index([scope, namespace])
  @@index([ownerId])
}

model ArticleTag {
  articleId String
  tagId     String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
  @@index([articleId])
}

model ArticleSpeech {
  id           String   @id @default(cuid())
  articleId    String   @unique
  mediaAssetId String?  @unique
  words        Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  article    Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
}

model QuizQuestion {
  id           String   @id @default(cuid())
  articleId    String
  question     String
  options      Json
  correctIndex Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, question])
  @@index([articleId])
}

model VocabularyItem {
  id          String   @id @default(cuid())
  articleId   String
  word        String
  explanation String
  example     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, word])
  @@index([articleId])
}

model SavedWord {
  id              String    @id @default(cuid())
  userId          String
  word            String
  explanation     String?
  example         String?
  contextSentence String?
  articleId       String?
  dueAt           DateTime?
  intervalDays    Int       @default(0)
  easeFactor      Float     @default(2.5)
  repetitions     Int       @default(0)
  lastReviewedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, word])
  @@index([userId])
  @@index([userId, articleId], map: "SavedWord_user_article_idx")
  @@index([userId, createdAt], map: "SavedWord_user_created_idx")
  @@index([userId, dueAt], map: "SavedWord_due_idx")
}

model DailyActivity {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime
  articlesRead Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model LevelHistory {
  id        String   @id @default(cuid())
  userId    String
  level     String
  changedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Translation {
  id         String   @id @default(cuid())
  articleId  String
  targetLang String
  content    String
  model      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, targetLang])
  @@index([articleId])
}

model ReadingProgress {
  id          String    @id @default(cuid())
  userId      String
  articleId   String
  percent     Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId])
  @@index([userId, completed, updatedAt], map: "ReadingProgress_user_completed_updated_idx")
  @@index([userId, completed, completedAt], map: "ReadingProgress_user_completedAt_idx")
  @@index([articleId], map: "ReadingProgress_article_idx")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "Account_user_idx")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Session_user_idx")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ReadingList {
  id        String   @id @default(cuid())
  userId    String
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ReadingListItem[]

  @@unique([userId, name])
  @@index([userId])
}

model ReadingListItem {
  id        String   @id @default(cuid())
  listId    String
  articleId String
  addedAt   DateTime @default(now())

  list    ReadingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  article Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([listId, articleId])
  @@index([articleId])
}

// M12 — AI Tutor chat
// Per-user, per-article conversation history. Messages are persisted only on
// successful AI responses; fallback turns are NEVER persisted.
model TutorMessage {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  role      String   // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([userId, articleId])
}

// M11 — Highlights & Notes
// Anchors are W3C-annotation-style: quote + character offsets into the article's
// rendered plain text (textContent), plus ±24-char prefix/suffix for re-anchoring.
// Anchor fields are IMMUTABLE after creation; only note/color may be updated.
model Highlight {
  id          String   @id @default(cuid())
  userId      String
  articleId   String
  // --- anchor (immutable) ---
  quote       String   // exact highlighted text
  startOffset Int      // char offset into article plain text (inclusive)
  endOffset   Int      // char offset into article plain text (exclusive)
  prefix      String   @default("") // up to 24 chars before the selection
  suffix      String   @default("") // up to 24 chars after the selection
  // --- editable ---
  note        String?  // user annotation (markdown allowed)
  color       String?  // e.g. "yellow" | "green" | "blue" | "pink"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId, startOffset, endOffset])
  @@index([userId, articleId])
  @@index([userId, createdAt], map: "Highlight_user_created_idx")
}

// M13 — Sentence-level translation cache
// Caches on-demand sentence/phrase translations so the same selection is
// never re-sent to the AI. Keyed by article + a SHA-256 hash of the
// normalized source text + target language. Cascade-deletes with the article.
model SentenceTranslation {
  id          String   @id @default(cuid())
  articleId   String
  sourceHash  String   // SHA-256 hex of normalized source text (stable cache key)
  targetLang  String
  translation String
  createdAt   DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, sourceHash, targetLang])
  @@index([articleId])
}

// M14 — Quiz Mastery & History
// Records each individual quiz attempt a user makes on an article.
// scorePct is computed at write time (0–100). Multiple attempts are allowed.
model QuizAttempt {
  id             String   @id @default(cuid())
  userId         String
  articleId      String
  correctCount   Int
  totalQuestions Int
  scorePct       Int      // 0–100, computed: round(correctCount / totalQuestions * 100)
  // RW-042 — idempotency key for offline-queued re-syncs. A duplicate submit
  // with the same key returns the existing attempt instead of double-recording.
  clientMutationId String? @unique
  completedAt    DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([userId, articleId])
  @@index([userId, completedAt])
}

// M16 — Pronunciation Practice
// Records each pronunciation attempt a user makes (article-linked or freeform).
// Assessment runs client-side via the Azure Speech SDK; scores are server-persisted.
model PronunciationAttempt {
  id                String   @id @default(cuid())
  userId            String
  articleId         String?  // nullable — practice may be freeform or article-linked
  referenceText     String
  accuracyScore     Int      // 0–100
  fluencyScore      Int      // 0–100
  completenessScore Int      // 0–100
  pronScore         Int      // 0–100 overall pronunciation score
  createdAt         DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Web Push subscriptions — stored per user, pruned when endpoint returns 404/410.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  // RW-045 — delivery tracking: consecutive transient failures + last
  // success/failure timestamps. Used to prune unhealthy endpoints reliably
  // (in addition to immediate 404/410 pruning) and to make sends observable.
  failureCount  Int       @default(0)
  lastSuccessAt DateTime?
  lastFailureAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// #114 — Per-article AI grammar explanation cache.
// Keyed by (articleId, normalized phrase) so the same phrase in the same
// article reuses the cached explanation instead of calling the AI again.
model GrammarExplanation {
  id          String   @id @default(cuid())
  articleId   String
  phrase      String
  explanation String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, phrase])
  @@index([articleId])
}

// #124 — Per-user difficulty feedback for articles.
// Vote is one of: too_easy | just_right | too_hard.
// @@unique enforces one vote per user per article (upsert to change vote).
model ArticleDifficultyFeedback {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  vote      String   // "too_easy" | "just_right" | "too_hard"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([articleId])
}

// #783/#788 — Today Session: one durable workflow anchor per learner-local day.
//
// Stores ANCHORS and IDENTIFIERS ONLY (article ids, saved-word ids, statuses,
// timestamps) — never learning content (no article text, word text,
// definitions, examples, context sentences, or notes). `primaryArticleId`,
// `backupArticleIds`, and `targetSavedWordIds` are plain string ids (NOT FKs)
// revalidated in code at read time, so deleting an Article or SavedWord never
// erases or cascades into a Today session. Only user deletion cascades.
//
// Controlled string fields (status/source/completionTier/generationReasonCode/
// skipReason) follow the `ArticleDifficultyFeedback.vote` convention rather than
// new Prisma enums, keeping SQLite and PostgreSQL schemas in single-source sync.
//
// `localDate` is the learner-local calendar day as "YYYY-MM-DD" (NOT a UTC
// DateTime bucket); `timezoneSnapshot` records the IANA zone used to compute it.
model TodaySession {
  id                String   @id @default(cuid())
  userId            String
  localDate         String // "YYYY-MM-DD" in the learner's local calendar
  timezoneSnapshot  String // IANA timezone used to resolve localDate

  // Plan anchors — ids only, no content. Revalidated in code before display.
  primaryArticleId    String?
  backupArticleIds    Json    @default("[]") // string[] of Article ids
  targetSavedWordIds  Json    @default("[]") // string[] of SavedWord ids
  reviewTargetCount   Int     @default(0)

  // Controlled string values (see today-session/types.ts validators).
  status               String  @default("active") // "active" | "completed" | "skipped"
  source               String  @default("none") // "resume" | "picks" | "none"
  completionTier       String  @default("none") // "none" | "reading" | "comprehension" | "full"
  generationReasonCode String  @default("no_candidate") // why the plan was produced

  // Lifecycle completion timestamps.
  readingCompletedAt       DateTime?
  comprehensionCompletedAt DateTime?
  wordReviewCompletedAt    DateTime?
  completedAt              DateTime?

  // Skip lifecycle.
  skipped    Boolean   @default(false)
  skipReason String? // controlled value when skipped, see types.ts
  skippedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, localDate])
  @@index([userId])
}

// Durable security/admin audit event store. Actor/target ids are stored as
// immutable string identifiers (not FKs) so deleting users/articles/tags never
// erases the investigation trail.
model AuditLog {
  id         String   @id @default(cuid())
  action     String
  actorId    String?
  actorRole  String?
  targetType String
  targetId   String?
  metadata   String   @default("{}")
  requestId  String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

// Durable background-job queue (RW-013/014/015). DB-backed so jobs survive
// restarts and can be claimed safely by multiple workers. `payload` references
// (e.g. articleId) are plain strings, NOT FKs, so a job row is independent of
// the entity it acts on (and survives its deletion, like AuditLog/SavedWord).
// `type`/`status` are enums in the schema but TEXT columns in the migrations
// (matching the ArticleStatus convention); claim logic uses raw SQL on
// PostgreSQL (FOR UPDATE SKIP LOCKED) and a serialized transaction on SQLite.
model Job {
  id             String    @id @default(cuid())
  type           JobType
  status         JobStatus @default(PENDING)
  payload        Json
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  priority       Int       @default(0)
  runAfter       DateTime  @default(now())
  lockedBy       String?
  lockedAt       DateTime?
  lastError      String?
  errorHistory   Json
  dedupeKey      String?   @unique
  startedAt      DateTime?
  completedAt    DateTime?
  failedAt       DateTime?
  deadLetteredAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, runAfter])
  @@index([status, type, runAfter])
  @@index([type, status])
  @@index([lockedBy])
  @@index([lockedAt])
}

// Step-level article processing state (RW-016). A durable, per-article
// per-step timeline of the enrichment pipeline so admins can answer "why is
// this article not fully enriched?". One row per (articleId, step); `step`
// is a feature label (difficulty|tags|vocabulary|quiz|speech|grammar) or a
// language-scoped translation key ("translation:es"). METADATA ONLY — model
// name / prompt version / a short error message are stored, never prompt
// content. Cascades with the article (unlike the Job/ledger string refs, this
// IS a real FK so step state is cleaned up with its article).
model ArticleProcessingStep {
  id            String    @id @default(cuid())
  articleId     String
  step          String
  status        String    @default("pending")
  attempts      Int       @default(0)
  startedAt     DateTime?
  completedAt   DateTime?
  modelName     String?
  promptVersion String?
  lastError     String?
  fallbackReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, step])
  @@index([articleId])
  @@index([status])
  @@index([fallbackReason])
}

// AI invocation ledger (RW-019). First-class operational record of every AI
// provider call so cost, quota, quality, and feature usage can be analyzed.
// METADATA ONLY — full prompts/responses are intentionally never stored.
// `userId`/`articleId` are plain string identifiers (NOT FKs, like AuditLog/Job)
// so the ledger survives user/article deletion and never cascades. `status`
// reuses the AI outcome vocabulary from chatCompleteWithMeta/recordAiCall
// (success | error | empty | unconfigured | aborted); `fallback` flags whether
// the feature degraded to a non-AI path. Writes are best-effort and must never
// break an AI feature.
model AiInvocation {
  id               String   @id @default(cuid())
  feature          String
  model            String?
  promptVersion    String?
  userId           String?
  articleId        String?
  requestId        String?
  status           String
  fallback         Boolean  @default(false)
  fallbackReason   String?
  cacheHit         Boolean  @default(false)
  latencyMs        Int?
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  estimatedCostUsd Float?
  errorMessage     String?
  createdAt        DateTime @default(now())

  @@index([feature, createdAt])
  @@index([model])
  @@index([status])
  @@index([fallbackReason])
  @@index([userId])
}

// Shared (DB-backed) fixed-window rate-limit counter (RW-026). Replaces the
// process-local limiter so limits are enforced consistently across instances.
// Each row is one (bucketKey, windowStart) bucket; an atomic upsert increments
// `count` within the window. `expiresAt` lets a best-effort sweep prune stale
// rows. The in-memory limiter remains a graceful fallback when the DB store is
// unavailable. bucketKey already encodes the scope (e.g. "u1:ai").
model RateLimitCounter {
  bucketKey   String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@id([bucketKey, windowStart])
  @@index([expiresAt])
}

// ===========================================================================
// Learning mastery foundation (Epic RW-E007 — RW-036/037/038).
//
// Durable, query-able representations of how well a user knows each WORD,
// ARTICLE, and SKILL. These complement (never replace) the activity tables
// they are derived from (SavedWord, ReadingProgress, QuizAttempt,
// PronunciationAttempt, ArticleDifficultyFeedback, GrammarExplanation): the
// raw activity remains the source of truth, while these models cache a rolled-
// up mastery estimate that SRS, recommendations and leveling can read cheaply.
// All updates are best-effort side-effects — a write failure here must never
// break the underlying user action.
// ===========================================================================

// RW-036 — Per-user word mastery keyed by a normalized lemma (base form).
// Lemma normalization reuses the dictionary lemmatizer (normalizeCandidates)
// so inflections collapse onto a single row. `familiarity`/`confidence` are
// 0–1 transparent scores blended from exposures + review accuracy.
// `sourceArticleIds` is a JSON array of the (most recent) article ids the word
// was encountered in (bounded). Cascades with the user.
model WordMastery {
  id               String    @id @default(cuid())
  userId           String
  lemma            String
  familiarity      Float     @default(0)
  exposures        Int       @default(0)
  correctReviews   Int       @default(0)
  incorrectReviews Int       @default(0)
  confidence       Float     @default(0)
  sourceArticleIds Json      @default("[]")
  lastSeenAt       DateTime  @default(now())
  lastReviewedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lemma])
  @@index([userId])
  @@index([userId, familiarity])
  @@index([userId, lastSeenAt])
}

// RW-037 — Per-user, per-article comprehension state. A single durable
// representation of how well a user understood an article, combining reading
// completion, best quiz score, dictionary lookup density, time spent and the
// user's difficulty vote into a transparent `comprehensionScore` (0–1).
// Cascades with both the user AND the article.
model ArticleMastery {
  id                 String    @id @default(cuid())
  userId             String
  articleId          String
  readingCompletion  Float     @default(0)
  quizScore          Float?
  lookupDensity      Float?
  timeSpentMs        Int?
  difficultyFeedback String?
  comprehensionScore Float     @default(0)
  lastActivityAt     DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId])
  @@index([articleId])
  @@index([userId, lastActivityAt])
}

// RW-038 — Per-user skill confidence across the six learning dimensions
// (reading, vocabulary, grammar, listening, pronunciation, comprehension).
// `confidence` is an internal 0–1 numeric tracked with an exponential moving
// average; CEFR stays the user-facing output. `recentEvidence` is a small
// bounded JSON array of recent {outcome, weight, at} summaries (NO sensitive
// content). Cascades with the user.
model SkillMastery {
  id             String   @id @default(cuid())
  userId         String
  skill          String
  confidence     Float    @default(0)
  evidenceCount  Int      @default(0)
  recentEvidence Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skill])
  @@index([userId])
}

// RW-045 — Per-user push reminder preferences (timing + quiet hours).
// 1-1 with User; cascades on account deletion. Hours are 0–23 in the user's
// local timezone (`timezone`, falling back to Profile.timezone then UTC).
// Quiet hours suppress sends; `preferredHour` gates the daily reminder to a
// single local hour. Appended last (additive) to minimize merge friction with
// concurrent schema work.
model ReminderPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  enabled         Boolean  @default(true)
  preferredHour   Int?
  quietHoursStart Int?
  quietHoursEnd   Int?
  timezone        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ===========================================================================
// Product analytics event model (Epic RW-E010 — RW-051).
//
// A general-purpose, append-only stream of product analytics events that
// COMPLEMENTS (never replaces) the domain/activity tables. It powers funnel,
// activation, retention and feature-usage analysis (RW-052) without coupling
// those dashboards to a dozen different domain tables.
//
// Design principles (mirroring the AiInvocation/AuditLog ledgers):
//   - METADATA ONLY. `properties` holds small, non-sensitive metadata (counts,
//     enums, ids) — NEVER article text, selected text, prompts, or PII. The
//     `recordEvent` writer sanitizes + version-stamps the payload.
//   - NON-FK REFERENCES. `userId`/`articleId` are plain string identifiers (NOT
//     foreign keys, like AuditLog/AiInvocation/Job) so an event survives user or
//     article deletion and never cascades. Privacy is enforced by the documented
//     retention window (`pruneOldEvents`) and an explicit `deleteEventsForUser`.
//   - BEST-EFFORT. Writes never throw — an analytics write must never break the
//     user action that emitted it.
//
// See `docs/analytics/product-analytics.md` for the versioned event schema + retention rules.
model AnalyticsEvent {
  id          String   @id @default(cuid())
  type        String
  userId      String?
  anonymousId String?
  articleId   String?
  sessionId   String?
  properties  Json     @default("{}")
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([type, occurredAt])
  @@index([userId, occurredAt])
  @@index([occurredAt])
}

// ===========================================================================
// Content source governance & operational state (Epic RW-E009 — RW-046/050).
//
// Provider EXTRACTION logic stays in code (src/lib/scraper/providers.ts). This
// model holds only OPERATIONAL state for each registered provider: whether it
// is enabled, its crawl policy, last-crawl health, and cumulative ingestion
// quality counters used to flag drift (zero-discovery / high-failure runs).
// Rows are synced from the code registry via syncContentSources(); the scraper
// reads `enabled` to skip disabled providers. `providerKey` matches the code
// registry key (NON-FK by nature — it references provider keys, not rows).
// ===========================================================================
model ContentSource {
  id                       String    @id @default(cuid())
  providerKey              String    @unique
  displayName              String
  baseUrl                  String?
  enabled                  Boolean   @default(true)
  crawlPolicy              Json      @default("{}")
  healthStatus             String    @default("unknown")
  lastError                String?
  lastCrawledAt            DateTime?
  lastDiscoveryCount       Int       @default(0)
  totalDiscovered          Int       @default(0)
  totalScraped             Int       @default(0)
  totalFailed              Int       @default(0)
  totalDuplicates          Int       @default(0)
  totalRejected            Int       @default(0)
  consecutiveFailures      Int       @default(0)
  consecutiveZeroDiscovery Int       @default(0)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([enabled])
  @@index([healthStatus])
}

// Privacy-safe crawl-run summaries for provider drift triage. These rows store
// only operational counters and coarse labels — never URLs, article text,
// prompts, selected text, definitions, translations, or user-private content.
model CrawlRun {
  id          String   @id @default(cuid())
  providerKey String
  source      String
  mode        String
  outcome     String
  durationMs  Int?
  discovered  Int      @default(0)
  scraped     Int      @default(0)
  failed      Int      @default(0)
  duplicates  Int      @default(0)
  rejected    Int      @default(0)
  error       String?
  createdAt   DateTime @default(now())

  @@index([providerKey, createdAt])
  @@index([outcome, createdAt])
}

// Content quality review & moderation history (Epic RW-E009 — RW-048). An
// append-only trail of moderation actions on an article (review-state changes,
// field corrections, takedown/unpublish/archive). `reviewerId` is a plain
// string (NOT an FK, like AuditLog.actorId) so history survives a reviewer's
// account deletion. `changes` holds a small metadata diff of what was
// corrected. Cascades with the article.
model ContentReview {
  id         String   @id @default(cuid())
  articleId  String
  reviewerId String?
  action     String
  note       String?
  changes    Json     @default("{}")
  createdAt  DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
  @@index([action, createdAt])
}

// Media storage metadata (Epic RW-E009 — RW-049). Generated audio is written
// outside the relational DB to local or Azure media storage; this row records
// the canonical pointer and playback metadata. Each row tracks one stored
// object so superseded objects remain available for lifecycle cleanup.
model MediaAsset {
  id          String   @id @default(cuid())
  storageKey  String   @unique
  kind        String   @default("speech")
  mimeType    String
  voice       String?
  articleId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  article Article?      @relation(fields: [articleId], references: [id], onDelete: Cascade)
  speech  ArticleSpeech?

  @@index([articleId])
  @@index([kind, createdAt])
}

// ===========================================================================
// Multi-tenancy: organizations, memberships, classrooms & assignments
// (Epic RW-E012 — RW-060/061). Additive and NULLABLE by design: an account
// with no Membership is unchanged (the global single-user experience). Tenant
// roles are SEPARATE from the global Role enum (Admin/Reader) — an OrgAdmin is
// not a ReadWise system admin (see docs/access/multi-tenancy.md + src/lib/rbac.ts).
// ===========================================================================

/// Tenant role inside an Organization. Resolved to capabilities per-membership
/// in src/lib/rbac.ts (OrgAdmin/Teacher carry tenant capabilities; Member/
/// Student carry only the base reader capabilities).
enum MembershipRole {
  OrgAdmin
  Teacher
  Member
  Student
}

/// Role inside a single Classroom. Teachers manage the roster + assignments;
/// students receive assigned readings.
enum ClassroomRole {
  Teacher
  Student
}

/// Lifecycle of a single student's work on an Assignment.
enum AssignmentStatus {
  ASSIGNED    @map("assigned")
  IN_PROGRESS @map("in_progress")
  COMPLETED   @map("completed")
}

enum AssignmentCompletionSource {
  SELF    @map("self")
  READING @map("reading")
  QUIZ    @map("quiz")
}

enum AssignmentPublishState {
  DRAFT     @map("draft")
  SCHEDULED @map("scheduled")
  PUBLISHED @map("published")
}

// ===========================================================================
// Content Reporting — user-submitted safety/quality/rights reports and admin
// moderation queue (Epic #734 — #738). Reports reference content by articleId.
// No raw article text, selected text, or PII is stored — only IDs and category
// metadata.
// ===========================================================================

/// Why the user submitted the report.
enum ContentReportReason {
  RIGHTS_COPYRIGHT     @map("rights_copyright")
  UNSAFE_CONTENT       @map("unsafe_content")
  EXTRACTION_BROKEN    @map("extraction_broken")
  WRONG_LEVEL          @map("wrong_level")
  INACCURATE_AI        @map("inaccurate_ai")
  CLASSROOM_CONCERN    @map("classroom_concern")
  OTHER                @map("other")
}

/// Lifecycle of a ContentReport in the moderation queue.
enum ContentReportStatus {
  OPEN       @map("open")
  REVIEWING  @map("reviewing")
  RESOLVED   @map("resolved")
  DISMISSED  @map("dismissed")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  classrooms  Classroom[]

  @@index([slug])
}

model Membership {
  id        String         @id @default(cuid())
  userId    String
  orgId     String
  role      MembershipRole @default(Member)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([userId])
  @@index([orgId])
  @@index([orgId, role])
}

model Classroom {
  id         String    @id @default(cuid())
  orgId      String
  name       String
  teacherId  String
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  org         Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  teacher     User                  @relation("TaughtClassrooms", fields: [teacherId], references: [id], onDelete: Cascade)
  members     ClassroomMembership[]
  assignments Assignment[]

  @@index([orgId])
  @@index([orgId, archivedAt])
  @@index([teacherId])
}

model ClassroomMembership {
  id          String        @id @default(cuid())
  classroomId String
  userId      String
  role        ClassroomRole @default(Student)
  createdAt   DateTime      @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classroomId, userId])
  @@index([userId])
  @@index([classroomId, role])
}

model Assignment {
  id           String    @id @default(cuid())
  classroomId  String
  articleId    String
  dueDate      DateTime?
  instructions String?
  title        String?
  points       Int?
  publishState AssignmentPublishState @default(PUBLISHED)
  publishAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  classroom   Classroom              @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  article     Article                @relation(fields: [articleId], references: [id], onDelete: Cascade)
  completions AssignmentCompletion[]
  targets     AssignmentTarget[]

  @@index([classroomId])
  @@index([articleId])
}

model AssignmentTarget {
  id           String   @id @default(cuid())
  assignmentId String
  studentId    String
  createdAt    DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([assignmentId])
}

model AssignmentCompletion {
  id               String                      @id @default(cuid())
  assignmentId     String
  studentId        String
  status           AssignmentStatus            @default(ASSIGNED)
  quizScore        Int?
  pointsAwarded    Int?
  completionSource AssignmentCompletionSource?
  completedAt      DateTime?
  feedback         String?
  reviewedAt       DateTime?
  reviewedBy       String?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([assignmentId, status])
}

// User-submitted report on a piece of content. `reporterUserId` is a plain
// string (NOT an FK, like AuditLog.actorId) so reports survive account deletion.
// `resolvedBy` is likewise a plain string. No raw article text or selected text
// is stored — only the articleId + category + optional short note.
model ContentReport {
  id             String              @id @default(cuid())
  reporterUserId String
  articleId      String
  reason         ContentReportReason
  note           String?
  status         ContentReportStatus @default(OPEN)
  createdAt      DateTime            @default(now())
  resolvedAt     DateTime?
  resolvedBy     String?

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
  @@index([status, createdAt])
  @@index([reporterUserId, articleId])
}

// #806 — Lightweight reading placement result.
// Stores STRUCTURED OUTCOMES ONLY — no passage text, answers, or PII.
// One row per user; upserted on retake. Cascades with the user.
model PlacementResult {
  id                String    @id @default(cuid())
  userId            String    @unique
  /// Passage article id used for placement (NOT FK — survives article deletion).
  passageArticleId  String
  /// Self-reported seed level used to pick the passage.
  seedLevel         String    // "A2" | "B1" | "B2"
  /// Deterministic recommended starting level.
  recommendedLevel  String    // "A1" | "A2" | "B1" | "B2" | "C1"
  /// Number of questions presented (3–5).
  questionCount     Int
  /// Number of correct answers — no answer text stored.
  correctCount      Int
  /// Vocabulary lookup count during placement passage — count only.
  lookupCount       Int
  /// True when the learner skipped placement; recommendedLevel is null-coerced
  /// to seedLevel when skipped = true so Today still has a starting signal.
  skipped           Boolean   @default(false)
  /// Controlled: "initial" | "retake"
  attempt           String    @default("initial")
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// #807 Phase 2 — Lightweight comprehension check outcome per Today session.
// Stores question ids and boolean outcomes ONLY — no answer text, option text,
// article text, or explanations.  One row per Today session.
model TodayComprehensionFeedback {
  id              String   @id @default(cuid())
  userId          String
  /// Plain string reference to TodaySession.id (NOT FK — survives session
  /// reset; only user deletion cascades).
  todaySessionId  String
  /// Article id at the time of the check — non-FK, survives article deletion.
  articleId       String
  /// Controlled self-rating: "confident" | "partial" | "confused"
  selfRating      String
  /// Optional: id of the QuizQuestion that was asked (null if no MCQ shown).
  questionId      String?
  /// True when the MCQ was answered correctly; null when no MCQ was shown.
  mcqCorrect      Boolean?
  /// Controlled skill tag from the question if available:
  /// "main_idea" | "detail" | "inference" | "vocabulary_in_context"
  skillTag        String?
  /// True when the learner opened the remediation card (engagement signal).
  remediationViewed Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, articleId])
}

// #810 — Structured long-term learner weakness memory for Tutor and Study Plan.
// Stores ONLY aggregated skill signals — no prompts, article text, question
// text, answer text, definitions, notes, or PII.
// One row per (userId, skill). Cascades with the user.
model LearnerCoachMemory {
  id             String    @id @default(cuid())
  userId         String
  /// Controlled skill key — one of the six SkillMastery skills plus
  /// two reading-specific dimensions:
  /// "reading" | "vocabulary" | "grammar" | "listening" |
  /// "pronunciation" | "comprehension" | "main_idea" | "inference"
  skill          String
  /// 0–1 confidence estimate blended from SkillMastery and comprehension
  /// check outcomes. Low values indicate weakness.
  confidence     Float     @default(0)
  /// Count of evidence events contributing to this entry (bounded; capped
  /// at 100 before export to prevent runaway accumulation).
  evidenceCount  Int       @default(0)
  /// ISO-8601 timestamp of the most recent evidence event that updated
  /// this entry. Used for recency decay.
  lastObservedAt DateTime  @default(now())
  /// Controlled trend direction: "improving" | "stable" | "declining"
  trend          String    @default("stable")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skill])
  @@index([userId])
}

// #903 — Weekly study-plan snapshots for stable learner goals/history.
// Stores derived plan structure and aggregate evidence only — no article text,
// selected text, definitions, translations, prompts, or generated AI content.
model StudyPlanSnapshot {
  id          String   @id @default(cuid())
  userId      String
  weekStart   DateTime
  weekEnd     DateTime
  generatedAt DateTime @default(now())
  summary     String
  isStarter   Boolean  @default(false)
  weakAreas   Json     @default("[]")
  items       Json     @default("[]")
  sourceVersion String  @default("study-plan-v1")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([userId, generatedAt])
}

// #813 — Curated reading series definition.
// A named, ordered list of article ids for themed or leveled reading paths.
// Article ids are NOT foreign keys — series survive article deletion;
// orphaned ids are skipped silently at read time.
model ReadingSeries {
  id              String    @id @default(cuid())
  /// Slug used in URLs and analytics: "7-days-tech-news", "b1-b2-ladder"
  slug            String    @unique
  title           String
  description     String?
  /// Target CEFR level range: "A2" | "B1" | "B2" | "C1" | null (any)
  targetLevelMin  String?
  targetLevelMax  String?
  /// Topic tag used for recommendation scoring (matches Article.category values)
  topic           String?
  /// Ordered array of Article ids — NOT FKs. Revalidated at serve time.
  articleIds      Json      @default("[]") // string[]
  /// Controlled: "active" | "archived"
  status          String    @default("active")
  /// Whether series appears in public series browser (learner-facing)
  public          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  enrollments  SeriesEnrollment[]

  @@index([status])
  @@index([topic])
}

// #813 — Per-user enrollment in a curated series.
// Tracks position and completion without storing article content.
model SeriesEnrollment {
  id              String    @id @default(cuid())
  userId          String
  seriesId        String
  /// Index of the next article to read (0-based; clamped to articleIds length).
  nextIndex       Int       @default(0)
  /// Controlled: "active" | "paused" | "completed"
  status          String    @default("active")
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  series ReadingSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([userId, seriesId])
  @@index([userId])
  @@index([userId, status])
}

// ===========================================================================
// Incremental provider discovery ledger (Epic RW-E-incremental — #1077 / #1081).
//
// Durable, first-class relational state for STATEFUL incremental provider
// ingestion. Provider EXTRACTION and ADMISSION logic stay versioned in code
// (src/lib/scraper/*); these models hold only OPERATIONAL scheduling state and
// a PERMANENT candidate/alias ledger.
//
// Governing invariant (#1077): normal incremental ingestion processes only
// article identities first observed AFTER a completed source baseline, and must
// never automatically refetch, update, recreate, or revive a known public
// Article. The ledger enforces this by making candidate identity PERMANENT and
// DELETION-SAFE: CrawlCandidate.articleId is nullable + `onDelete: SetNull`, so
// deleting an Article never deletes or resets the candidate identity that marks
// a provider URL as already handled.
//
// Orthogonal controlled fields: source ROLE, LIFECYCLE MODE, AUTOMATION POLICY,
// and HEALTH are SEPARATE enums/columns, never one overloaded state column.
//
// METADATA ONLY. No article text, credentials, cookies, tokens, signed URLs,
// prompts, translations, or user-private content is stored. Identity keys
// (`provisionalKey`, `canonicalKey`, `aliasKey`, `observationKey`) are versioned,
// SANITIZED digests of a URL identity — never the raw secret-bearing URL.
// `providerKey` mirrors the ContentSource/CrawlRun convention: a plain string
// that references the code provider registry key, NOT a foreign key, so the
// ledger is independent of ContentSource row lifecycle.
// ===========================================================================

/// Discovery source ROLE — the kind of discovery surface a source represents.
/// Orthogonal to lifecycle mode, automation policy, and health.
enum DiscoverySourceRole {
  PRIMARY_FEED
  SECTION_INDEX
  ARCHIVE_INDEX
  SITEMAP
  SUPPLEMENTAL
}

/// Discovery source LIFECYCLE MODE — position in the
/// disabled → baseline → shadow → active progression. A source starts DISABLED,
/// completes a bounded BASELINE (its known observable set), runs in SHADOW to
/// prove new-item discovery WITHOUT body work, then becomes ACTIVE.
/// PAUSED/RETIRED are operator states.
enum DiscoverySourceLifecycleMode {
  DISABLED
  SHADOW
  BASELINE
  ACTIVE
  PAUSED
  RETIRED
}

/// Discovery AUTOMATION POLICY — how much scheduling autonomy is granted,
/// independent of lifecycle mode.
enum DiscoveryAutomationPolicy {
  MANUAL
  SCHEDULED
  CONTINUOUS
}

/// Discovery source HEALTH — operational health, independent of lifecycle mode
/// and automation policy.
enum DiscoverySourceHealth {
  UNKNOWN
  HEALTHY
  DEGRADED
  FAILING
  BLOCKED
}

/// Completeness GAP state (#1077: expose uncertainty, never hide a gap).
enum DiscoveryGapState {
  NONE
  SUSPECTED
  DETECTED
}

/// CrawlCandidate lifecycle STATUS — controlled progression of a permanent
/// public-ingestion identity. Orthogonal to `observedInBaseline` (baseline
/// membership is a separate flag, not a status).
///   - DUPLICATE_ALIAS: a later candidate that resolved to the SAME trusted
///     final canonical identity (or same-provider prose fingerprint) as an
///     earlier winning candidate; it was folded into the winner (aliases +
///     observations re-pointed) and its downstream ingest cancelled (#1092).
///   - NEEDS_REVIEW: a candidate whose trusted final canonical is an unknown
///     cross-domain host, or whose prose fingerprint matched a DIFFERENT
///     provider's content; it is parked BEFORE Article creation with an
///     auditable CanonicalConflict row (#1092).
///   - QUARANTINED: a no-Article candidate whose ingest attempts were EXHAUSTED
///     on a transient failure (timeout / network / 404-after-grace / 429 / 5xx /
///     short extraction) OR that failed deterministic extraction/quality
///     validation. ONE visible resting state that ordinary source rescans never
///     re-enqueue; only a bounded extractor-version upgrade may reactivate it
///     (#1093). Distinct from REJECTED (permanent 410 / access-restricted).
///   - SKIPPED_REVIEW: a NEEDS_REVIEW candidate an authorized operator EXPLICITLY
///     rejected in candidate review (#1100). A terminal, no-Article resting state
///     that ordinary rediscovery/ingest NEVER re-enqueues (governing invariant);
///     it may return to NEEDS_REVIEW only through the separate audited reactivate
///     action. Distinct from REJECTED (provider-driven permanent 410) and SKIPPED
///     (policy/frontier skip): SKIPPED_REVIEW is a human review decision.
enum CrawlCandidateStatus {
  DISCOVERED
  BASELINE
  QUEUED
  INGESTING
  INGESTED
  SKIPPED
  REJECTED
  FAILED
  CONFLICT
  DUPLICATE_ALIAS
  NEEDS_REVIEW
  QUARANTINED
  SKIPPED_REVIEW
  SKIPPED_OUTSIDE_WINDOW
}

/// Provenance of the trusted publication date recorded for a candidate.
enum CandidateDateProvenance {
  UNKNOWN
  FEED
  PAGE_METADATA
  URL
  HTTP_HEADER
  INFERRED
}

/// Kind of URL alias mapped onto a candidate identity.
enum UrlAliasKind {
  PROVISIONAL
  REDIRECT
  CANONICAL
  DUPLICATE
  MIRROR
}

/// Lifecycle of a canonical-identity conflict.
enum CanonicalConflictStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// Durable per-source scheduling / lease / watermark record for incremental
/// discovery. One row per (providerKey, sourceKey, definitionVersion): bumping
/// the code-defined `definitionVersion` starts a fresh, independently-baselined
/// source without disturbing prior history. Complements (does not replace) the
/// existing ContentSource provider-health row and CrawlRun summaries.
model DiscoverySource {
  id                String @id @default(cuid())
  providerKey       String
  sourceKey         String
  definitionVersion Int    @default(1)

  role             DiscoverySourceRole          @default(PRIMARY_FEED)
  lifecycleMode    DiscoverySourceLifecycleMode @default(DISABLED)
  automationPolicy DiscoveryAutomationPolicy    @default(MANUAL)
  health           DiscoverySourceHealth        @default(UNKNOWN)

  /// Schedule
  scheduleCron        String?
  pollIntervalSeconds Int?
  nextRunAt           DateTime?
  lastRunAt           DateTime?

  /// Lease (single-writer worker coordination; `leaseOwner` is an opaque worker
  /// token, never a secret or credential).
  leaseOwner      String?
  leaseAcquiredAt DateTime?
  leaseExpiresAt  DateTime?

  /// Checkpoint for resumable pagination. `checkpointCursor` is an opaque,
  /// SANITIZED pagination token — never a raw URL, query string, or secret.
  checkpointCursor String?
  checkpointPage   Int?

  /// Watermark — the "first observed after baseline" frontier. `watermarkKey`
  /// is a sanitized identity key marking the last processed frontier position.
  watermarkAt  DateTime?
  watermarkKey String?

  /// Validator — version/fingerprint of the admission validator in code that
  /// last processed this source.
  validatorVersion String?

  /// Baseline — bounded initial completeness pass; incremental ingestion only
  /// acts on identities first observed AFTER `baselineCompletedAt`.
  baselineStartedAt     DateTime?
  baselineCompletedAt   DateTime?
  baselineObservedCount Int       @default(0)

  /// Activation
  activatedAt DateTime?
  /// Monotonic activation-generation marker (#1097, Phase 2.7). INCREMENTED on
  /// every active→shadow rollback so a body-fetch job whose pre-rollback
  /// generation snapshot predates the rollback fails closed at Article commit
  /// (via `revalidateSourceGeneration`) even after a LATER re-activation — the
  /// re-activated source's generation is strictly higher than the stale
  /// snapshot. A controlled counter, never a URL/secret.
  activationGeneration Int @default(0)

  /// Backoff on repeated failure.
  backoffUntil        DateTime?
  backoffLevel        Int       @default(0)
  consecutiveFailures Int       @default(0)

  /// Auto-degradation drift signal (#1089): consecutive successful
  /// (boundary-reached HTTP-200) runs that discovered ZERO new identities. Reset
  /// to 0 on any new discovery. A sustained streak demotes an ACTIVE source back
  /// to SHADOW (state-preserving + reversible).
  consecutiveZeroDiscoveryRuns Int @default(0)

  /// Separate budgets/priorities for discovery, body fetching, and historical
  /// backfill work (#1077).
  discoveryBudgetPerRun Int?
  bodyFetchBudgetPerRun Int?
  backfillBudgetPerRun  Int?

  /// Trusted-provider publication settings (#1096, Phase 2.6). All DEFAULT
  /// FALSE and independently granted — METADATA ONLY booleans, never a
  /// credential. They are deliberately SEPARATE permissions:
  ///   - canFetchAuthenticated: permission to fetch this source WITH credentials.
  ///     Grants access only; NEVER implies any right to republish publicly.
  ///   - canRepublishPublicly: permission to republish the source's content in
  ///     the PUBLIC library (source-ownership / republication rights).
  ///   - autoPublishTrusted: explicit trust to AUTO-publish a fully validated
  ///     draft without human review. It CANNOT be granted by the fetch or
  ///     republish flags alone — auto-publication requires this flag set
  ///     explicitly AND `canRepublishPublicly`.
  canFetchAuthenticated Boolean @default(false)
  canRepublishPublicly  Boolean @default(false)
  autoPublishTrusted    Boolean @default(false)

  /// Authenticated-provider ingestion settings (#1099, Phase 2.9). Both fields
  /// are SECRET-FREE metadata; the actual credential is NEVER persisted here.
  ///   - credentialRef: a stable NAME/handle (e.g. an env-var key or secret-store
  ///     key) the worker resolves to a live credential IN MEMORY at request time
  ///     (`resolveCredential`). It is NEVER the secret value, a token, a signed
  ///     URL, or an Authorization header. Rotating the secret behind a fixed
  ///     credentialRef requires NO candidate/job rewrite (AC2).
  ///   - authIdentityKind: how this source's items are identified. Only a stable,
  ///     secret-free identity ("stable-provider-id" / "canonical-url") may be
  ///     activated for automatic incremental ingestion; a source whose items are
  ///     identified ONLY by rotating signed URLs ("signed-url-only") is REFUSED
  ///     activation (AC3). Null means the identity kind is unspecified (treated as
  ///     a public/stable source with no authenticated-fetch requirement).
  credentialRef    String?
  authIdentityKind String?

  /// Completeness gap surfaced to operators.
  gapState      DiscoveryGapState @default(NONE)
  gapDetectedAt DateTime?
  gapNote       String?

  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidates   CrawlCandidate[]
  observations DiscoveryObservation[]

  @@unique([providerKey, sourceKey, definitionVersion])
  @@index([providerKey])
  @@index([lifecycleMode])
  @@index([health])
  @@index([automationPolicy])
  @@index([nextRunAt])
  @@index([leaseExpiresAt])
  @@index([gapState])
}

/// PERMANENT public-ingestion identity for a provider URL. This is the ledger
/// authority for whether a public provider identity has EVER been handled, and
/// is deliberately DELETION-SAFE: `articleId` is nullable with
/// `onDelete: SetNull`, so deleting the produced Article never deletes or resets
/// the candidate. `terminalReason`/`terminalAt`/`articleDeletedAt` preserve
/// deletion history. Identity keys are versioned + sanitized (never raw URLs).
model CrawlCandidate {
  id                String  @id @default(cuid())
  providerKey       String
  discoverySourceId String?

  /// Versioned, SANITIZED identity keys (never raw secret-bearing URLs).
  identityVersion Int     @default(1)
  provisionalKey  String
  canonicalKey    String?

  status             CrawlCandidateStatus @default(DISCOVERED)
  /// Orthogonal to `status`: true when the identity was first seen during the
  /// source baseline (a known, pre-existing identity that must NOT be
  /// auto-ingested by normal incremental runs).
  observedInBaseline Boolean              @default(false)

  firstObservedAt  DateTime @default(now())
  lastObservedAt   DateTime @default(now())
  observationCount Int      @default(0)

  /// Version of the extraction/admission code that last processed the candidate.
  processingVersion String?

  /// Ingest retry / quarantine / reactivation METADATA (#1093, Phase 2.3).
  /// METADATA ONLY — reason codes, counts, and timestamps; NEVER a response
  /// body, article text, secret, cookie, or authorization detail.
  ///   - ingestAttemptCount: transient-failure attempts made for the CURRENT
  ///     ingest processing version.
  ///   - nextAttemptAt: when the next retry becomes runnable (backoff or a
  ///     server Retry-After), null once terminal/quarantined.
  ///   - lastFailureReason: machine failure reason code (see
  ///     `ingest-outcome.ts`), used to gate extractor-version reactivation.
  ///   - firstIngestAttemptAt: start of the propagation grace window; a 404
  ///     within grace is pre-propagation (retry), after grace is quarantine.
  ///   - extractorVersion: extractor/processing version that last handled the
  ///     candidate; also the ingest dedupe-key version, bumped on reactivation.
  ingestAttemptCount   Int       @default(0)
  nextAttemptAt        DateTime?
  lastFailureReason    String?
  firstIngestAttemptAt DateTime?
  extractorVersion     Int?

  /// Versioned NORMALIZED-PROSE fingerprint (#1092). `bodyFingerprint` is a
  /// one-way HASH of the normalized extracted prose — NEVER the prose text —
  /// and `bodyFingerprintVersion` tags the normalization+hash scheme
  /// (`PROSE_FINGERPRINT_VERSION`) so a scheme change never collides old and
  /// new hashes. Used ONLY for EXACT same-provider duplicate detection via the
  /// provider-scoped `@@index([providerKey, bodyFingerprint])`; there is
  /// deliberately NO global unique — a cross-provider match must be routed to
  /// review (rights/attribution differ), never auto-merged or failed.
  bodyFingerprint        String?
  bodyFingerprintVersion Int?

  /// Trusted publication date and where it came from.
  trustedPublishedAt DateTime?
  dateProvenance     CandidateDateProvenance @default(UNKNOWN)

  /// Terminal outcome + deletion-safe history.
  terminalReason   String?
  terminalAt       DateTime?
  ingestedAt       DateTime?
  articleDeletedAt DateTime?

  /// Optional Article linkage. NULLABLE + `onDelete: SetNull` (governing
  /// invariant): the candidate identity survives Article deletion so a known
  /// URL is never automatically re-ingested.
  articleId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  source       DiscoverySource?       @relation(fields: [discoverySourceId], references: [id], onDelete: SetNull)
  article      Article?               @relation(fields: [articleId], references: [id], onDelete: SetNull)
  aliases      UrlAlias[]
  observations DiscoveryObservation[]
  conflicts    CanonicalConflict[]

  @@unique([providerKey, identityVersion, provisionalKey])
  @@unique([providerKey, canonicalKey])
  @@index([providerKey])
  @@index([discoverySourceId])
  @@index([status])
  @@index([articleId])
  @@index([observedInBaseline])
  @@index([providerKey, status])
  @@index([providerKey, bodyFingerprint])
  @@index([status, nextAttemptAt])
}

/// Alternate SANITIZED identity keys (redirects, canonical links, duplicates,
/// mirrors) mapped onto a permanent candidate. Uses versioned sanitized keys,
/// never raw secret-bearing URLs. Cascades with its candidate (candidates are
/// permanent, so aliases survive Article deletion by construction).
model UrlAlias {
  id              String       @id @default(cuid())
  candidateId     String
  providerKey     String
  identityVersion Int          @default(1)
  aliasKey        String
  kind            UrlAliasKind @default(PROVISIONAL)
  firstSeenAt     DateTime     @default(now())
  lastSeenAt      DateTime     @default(now())
  createdAt       DateTime     @default(now())

  candidate CrawlCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([providerKey, identityVersion, aliasKey])
  @@index([candidateId])
  @@index([providerKey])
}

/// Idempotent record of a source seeing a candidate identity during a run.
/// Source-run scoped and EXPIRABLE: cascades when its DiscoverySource is deleted
/// (`onDelete: Cascade`). `runId` is a sanitized plain-string reference to a
/// CrawlRun (NON-FK; run summaries are independently prunable). Idempotency is
/// enforced by `@@unique([discoverySourceId, observationKey])`.
model DiscoveryObservation {
  id                   String    @id @default(cuid())
  discoverySourceId    String
  candidateId          String?
  runId                String?
  identityVersion      Int       @default(1)
  observationKey       String
  observedCanonicalKey String?
  positionRank         Int?
  httpStatus           Int?
  observedAt           DateTime  @default(now())
  createdAt            DateTime  @default(now())

  source    DiscoverySource @relation(fields: [discoverySourceId], references: [id], onDelete: Cascade)
  candidate CrawlCandidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([discoverySourceId, observationKey])
  @@index([discoverySourceId, observedAt])
  @@index([candidateId])
}

/// Unresolved conflict where more than one provisional identity resolves to the
/// same final canonical identity. Uses versioned sanitized identity keys and
/// SURVIVES Article deletion (references candidate identity, not the Article).
/// `incumbentCandidateId` uses `onDelete: SetNull` so the conflict record
/// persists; `challengerKey` is the sanitized provisional key of the challenger.
model CanonicalConflict {
  id                   String                  @id @default(cuid())
  providerKey          String
  identityVersion      Int                     @default(1)
  canonicalKey         String
  challengerKey        String
  incumbentCandidateId String?
  status               CanonicalConflictStatus @default(OPEN)
  reason               String?
  detectedAt           DateTime                @default(now())
  resolvedAt           DateTime?
  resolvedBy           String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  incumbent CrawlCandidate? @relation(fields: [incumbentCandidateId], references: [id], onDelete: SetNull)

  @@unique([providerKey, identityVersion, canonicalKey])
  @@index([providerKey])
  @@index([status])
  @@index([incumbentCandidateId])
}

/// Durable per-UTC-day request/budget counter for the rate governor (#1094,
/// Phase 2.4). ONE row per (scope, scopeKey, utcDay) holds the daily-windowed
/// counter that a worker restart must NOT reset within the day: hostname daily
/// ceiling, per-provider daily quota, and the separate discovery/body/AI cost
/// budgets. `scope` is a plain machine label ("hostname" | "provider" |
/// "discovery_budget" | "body_budget" | "ai_budget"); `scopeKey` is an opaque
/// sanitized hostname/provider key (or "global" for the cost budgets) — NEVER a
/// raw URL, secret, or user content. `utcDay` is a "YYYY-MM-DD" bucket, so a new
/// day starts a fresh counter automatically. Increments are idempotent/atomic via
/// upsert (INSERT..ON CONFLICT) inside the governing transaction.
model ScraperBudgetWindow {
  id           String   @id @default(cuid())
  scope        String
  scopeKey     String
  utcDay       String
  requestCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([scope, scopeKey, utcDay])
  @@index([scope, utcDay])
}

/// Cross-day per-hostname governor health state (#1094, Phase 2.4). ONE row per
/// hostname holds the state that MUST survive a worker restart and span UTC-day
/// boundaries: the min-interval anchor (`lastRequestAt`), the auto-pause window
/// (`pausedUntil` — from a server `Retry-After` or a 429/403/5xx backoff), and
/// the consecutive-error streak that drives the backoff. `hostKey` is an opaque
/// sanitized hostname — NEVER a raw URL, query string, secret, or cookie;
/// `lastFailureReason` is a machine reason code only.
model HostnameGovernorState {
  id                String    @id @default(cuid())
  hostKey           String    @unique
  lastRequestAt     DateTime?
  pausedUntil       DateTime?
  consecutiveErrors Int       @default(0)
  lastFailureReason String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([pausedUntil])
}

/// Lifecycle of an administrator-approved bounded historical backfill (#1101,
/// Phase 3.2). A run is created RUNNING and driven in bounded batches by the
/// worker; PAUSED/CANCELLED are explicit operator controls; COMPLETED when the
/// bounded scan is exhausted; FAILED reserved for an unrecoverable driver fault.
enum BackfillRunStatus {
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

/// Administrator-approved bounded historical backfill operation (#1101, Phase
/// 3.2). Fills a KNOWN historical interval without turning normal recovery into
/// an unbounded archive crawl: it reactivates ONLY matching historical
/// identities (OBSERVED_BASELINE = status BASELINE; OBSERVED_SHADOW = status
/// DISCOVERED + !observedInBaseline) that do NOT already have an Article and are
/// not blocked/deleted/policy-rejected, reusing the SAME candidate-ingest
/// pipeline as real-time work at a LOW priority that reserves capacity for
/// incremental. A gap suggestion NEVER starts one — an administrator must
/// approve the bounded operation.
///
/// Records the actor, reason, REQUESTED vs EFFECTIVE (clamped) bounds, progress
/// counters, failures, and cancellation; `checkpointCursor` (the last processed
/// candidate id) makes a large run resumable across pause/resume/cancel and a
/// worker restart WITHOUT duplicate jobs, and it NEVER widens the approved range.
///
/// METADATA ONLY: `actorId` is a plain string (NOT an FK, like AuditLog.actorId)
/// so the record survives account deletion; `reason` is sanitized operator text;
/// bounds are dates + counts; `checkpointCursor` is an opaque candidate id;
/// `warnings` holds sanitized clamp categories. NEVER a URL, article text,
/// secret, cookie, or user-private content.
model BackfillRun {
  id                String  @id @default(cuid())
  providerKey       String
  discoverySourceId String?
  actorId           String?
  reason            String

  /// REQUESTED bounds (as submitted) — the clamp evidence alongside the effective
  /// bounds below. `null` window bound = unbounded on that side.
  requestedWindowStart DateTime?
  requestedWindowEnd   DateTime?
  requestedMaxItems    Int

  /// EFFECTIVE (clamped) bounds the run actually enforces. The scan only ever
  /// queries within these; resume/retry re-reads them, so the approved range can
  /// never widen.
  windowStart DateTime?
  windowEnd   DateTime?
  maxItems    Int

  status BackfillRunStatus @default(RUNNING)

  /// Resumable checkpoint — the last processed candidate id (opaque, sanitized).
  /// The scan resumes at `id > checkpointCursor` after a pause/restart.
  checkpointCursor String?

  /// Progress counters (metadata only): identities matched within bounds,
  /// reactivated (transitioned + enqueued), skipped (matched but ineligible or
  /// concurrently changed), and failed.
  matchedCount     Int @default(0)
  reactivatedCount Int @default(0)
  skippedCount     Int @default(0)
  failedCount      Int @default(0)

  /// Sanitized warning categories (e.g. clamped-window / clamped-max) — never
  /// content.
  warnings Json?

  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([providerKey, status])
  @@index([discoverySourceId])
  @@index([createdAt])
}

/// Activation state of an Article content version (#1102, Phase 3.3).
///   - PENDING    — a force-rescrape replacement is fetched and validating; it
///                  holds the per-Article `pendingForArticleId` slot.
///   - ACTIVE     — the live readable version; it holds the per-Article
///                  `activeForArticleId` slot. Exactly one per Article.
///   - SUPERSEDED — a formerly ACTIVE version replaced by a newer activation.
///   - REJECTED   — a validation gate (canonical/safety/quality/identity or the
///                  annotation-migration gate) refused the replacement.
///   - FAILED     — a fetch/extract or internal error aborted the attempt.
enum ArticleContentVersionStatus {
  PENDING
  ACTIVE
  SUPERSEDED
  REJECTED
  FAILED
}

/// Durable Article content version (#1102, Phase 3.3). An AUDITED, operator-only
/// `force-rescrape` refreshes ONE known public Article by fetching + validating a
/// replacement into a PENDING row and, ONLY after every migration gate passes,
/// atomically ACTIVATING it while the previous ACTIVE version becomes SUPERSEDED —
/// preserving the Article id, ownership/visibility, reading relationships, and
/// audit history (the Article is UPDATED in place, never deleted/recreated). A
/// failed validation RETAINS the current ACTIVE version and records a controlled
/// REJECTED/FAILED row. Normal incremental discovery can NEVER reach this path
/// (governing invariant): force-rescrape is manual-only, capability-gated, audited.
///
/// CONCURRENCY (AC4) is DB-enforced by two nullable-unique slots that are set only
/// while a version occupies that state, so multiple NULLs coexist on BOTH SQLite
/// and PostgreSQL:
///   - `pendingForArticleId @unique` — a second concurrent force-rescrape that
///     tries to open a PENDING version hits the unique conflict and is rejected
///     cleanly (neither version is lost).
///   - `activeForArticleId @unique` — guarantees at most ONE ACTIVE version per
///     Article; activation clears the old slot then claims it for the new row.
///
/// PRIVACY: the versioned readable payload (`content`, `title`, urls, …) is
/// PRODUCT DATA that lives ONLY on this authoritative row — it is NEVER written to
/// logs, audit metadata, Job payloads, or error history. `requestedById` is a
/// sanitized plain string (NOT an FK, like AuditLog.actorId) so the provenance
/// survives account deletion; `reason` is sanitized operator justification and
/// `failureReason` is a machine code only.
model ArticleContentVersion {
  id        String                      @id @default(cuid())
  articleId String
  status    ArticleContentVersionStatus @default(PENDING)

  /// Versioned readable payload (product data — authoritative here, never logged).
  content        String  @default("")
  title          String  @default("")
  excerpt        String?
  author         String?
  heroImage      String?
  source         String?
  category       String?
  wordCount      Int?
  readingMinutes Int?
  sourceUrl      String?
  canonicalUrl   String?
  publishedAt    DateTime?

  /// Extraction provenance + versioned fingerprint of the normalized prose
  /// (`PROSE_FINGERPRINT_VERSION`); the prose text itself is NEVER stored.
  fingerprint        String?
  fingerprintVersion Int?
  extractorVersion   Int?

  /// Operator provenance: who requested/approved the replacement and why.
  requestedById String?
  reason        String
  /// Machine reason code for a controlled REJECTED/FAILED outcome (never content).
  failureReason String?

  /// #1103 — count + IDs of reader anchors that could NOT be reliably re-anchored
  /// onto this PROPOSED content (missing / ambiguous). Stamped when the
  /// annotation-migration gate BLOCKS activation, so the force-rescrape status
  /// endpoint can surface the uncertain anchors for operator/user confirmation
  /// instead of dropping them. Highlight IDs only — NEVER quote/note text.
  unresolvedAnchorCount Int?
  unresolvedAnchorIds   Json?

  /// Set at activation to MARK the Article's derived outputs (translations, speech,
  /// quiz, vocabulary, difficulty, processing steps) + reader annotations for
  /// regeneration/re-anchoring. #1102 only MARKS; #1103 consumes this seam to run
  /// the actual annotation re-anchoring + derived regeneration behind the gate.
  derivedRegenerationRequestedAt DateTime?

  /// DB-enforced at-most-one concurrency slots (see model doc). Set to the
  /// `articleId` ONLY while the row is PENDING / ACTIVE respectively, else null.
  pendingForArticleId String? @unique
  activeForArticleId  String? @unique

  createdAt    DateTime  @default(now())
  activatedAt  DateTime?
  supersededAt DateTime?
  updatedAt    DateTime  @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([articleId, status])
  @@index([status])
}
