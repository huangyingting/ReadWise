{
  "name": "readwise",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "node-ts": "node --env-file-if-exists=.env --experimental-strip-types --import ./scripts/register-ts.mjs",
    "test": "NODE_ENV=test node --env-file-if-exists=.env --experimental-strip-types --import ./scripts/register-ts.mjs --no-warnings --experimental-test-module-mocks --test \"tests/**/*.test.ts\"",
    "coverage:node": "node --experimental-strip-types --import ./scripts/register-ts.mjs --no-warnings scripts/check-node-coverage.ts",
    "benchmark:listings": "node --experimental-strip-types --import ./scripts/register-ts.mjs --no-warnings scripts/benchmark-listings.ts",
    "test:db": "NODE_ENV=test RUN_DB_INTEGRATION=1 node --env-file-if-exists=.env --experimental-strip-types --import ./scripts/register-ts.mjs --no-warnings --experimental-test-module-mocks --test-concurrency=1 --test \"tests/db/**/*.test.ts\"",
    "test:e2e:smoke": "playwright test --config=playwright.config.ts e2e/smoke.spec.ts e2e/onboarding-wizard.spec.ts",
    "test:e2e:ui-audit:high-risk": "playwright test --config=playwright.config.ts e2e/ui-audit-public-auth.spec.ts e2e/ui-audit-reader-learning.spec.ts e2e/ui-audit-classroom.spec.ts e2e/ui-audit-admin-operations.spec.ts e2e/admin-series-actions.spec.ts e2e/mobile-safe-area.spec.ts e2e/popover-viewport.spec.ts e2e/reader-root-viewport.spec.ts --grep @high-risk",
    "test:e2e:ui-audit:full": "playwright test --config=playwright.config.ts e2e/ui-audit-public-auth.spec.ts e2e/ui-audit-reader-learning.spec.ts e2e/ui-audit-classroom.spec.ts e2e/ui-audit-admin-operations.spec.ts",
    "test:e2e:visual": "PLAYWRIGHT_VISUAL_REGRESSION=1 playwright test --config=playwright.config.ts e2e/visual-regression.spec.ts",
    "scrape": "npm run node-ts -- scripts/scrape.ts",
    "scrape-review": "npm run node-ts -- scripts/scrape-review.ts",
    "process": "npm run node-ts -- scripts/process.ts",
    "worker": "npm run node-ts -- scripts/worker.ts",
    "seed": "npm run node-ts -- scripts/seed.ts",
    "eval": "npm run node-ts -- --no-warnings scripts/eval.ts",
    "difficulty:eval": "node --experimental-strip-types --import ./scripts/register-ts.mjs --no-warnings scripts/difficulty-eval.ts",
    "db:migrate": "prisma migrate deploy && prisma generate",
    "db:reset": "prisma migrate reset --force --skip-seed && prisma generate",
    "push-reminders": "npm run node-ts -- scripts/push-reminders.ts",
    "scrape:smithsonian": "npm run node-ts -- scripts/scrape-smithsonian.ts",
    "scrape:undark": "npm run node-ts -- scripts/scrape-undark.ts",
    "scrape:reading-sources": "npm run node-ts -- scripts/scrape-reading-sources.ts",
    "scrape:provider": "npm run node-ts -- scripts/scrape-provider.ts",
    "smithsonian:reset-scrape-analyze": "npm run db:reset && npm run scrape:smithsonian -- --limit 50 --target-saved --publish",
    "analyze:speech-alignment": "NODE_ENV=test npm run node-ts -- --no-warnings scripts/analyze-speech-alignment.ts",
    "prisma:generate": "prisma generate",
    "prisma:generate:pg": "prisma generate --schema prisma/postgresql/schema.prisma",
    "prisma:migrate:pg": "prisma migrate deploy --schema prisma/postgresql/schema.prisma",
    "postinstall": "prisma generate",
    "migrate-speech-timing": "npm run node-ts -- scripts/migrate-speech-timing.ts",
  "backfill:discovery-baseline": "npm run node-ts -- scripts/backfill-discovery-baseline.ts",
    "reconcile:discovery-canary": "npm run node-ts -- scripts/reconcile-discovery-canary.ts",
    "speech:batch": "npm run node-ts -- scripts/batch-synthesis.ts",
    "speech:keep": "npm run node-ts -- scripts/batch-synthesis.ts --all --loop",
    "schema:generate": "node --import ./scripts/register-ts.mjs --experimental-strip-types --no-warnings scripts/generate-schemas.ts",
    "schema:check-parity": "node --import ./scripts/register-ts.mjs --experimental-strip-types --no-warnings scripts/check-schema-parity.ts",
    "schema:validate": "DATABASE_URL=file:./dev.db prisma validate --schema prisma/schema.prisma && DATABASE_URL=postgresql://localhost:5432/readwise?schema=public prisma validate --schema prisma/postgresql/schema.prisma",
    "api-catalog": "node --experimental-strip-types --import ./scripts/register-ts.mjs --no-warnings scripts/generate-api-catalog.ts",
    "dict:prune": "npm run node-ts -- scripts/prune-local-dictionary.ts",
    "wordfreq:generate": "npm run node-ts -- scripts/generate-wordfreq-ranks.ts",
    "maintenance:retention": "npm run node-ts -- scripts/retention-maintenance.ts",
    "maintenance:rescrape-regen": "npm run node-ts -- scripts/reconcile-rescrape-regen.ts",
    "maintenance:orphan-narration": "npm run node-ts -- scripts/reap-orphan-narration.ts",
    "privacy:erase-ledgers": "npm run node-ts -- scripts/erase-user-ledgers.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@azure/storage-blob": "^12.33.0",
    "@mozilla/readability": "^0.6.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/sanitize-html": "^2.16.1",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "franc-min": "^6.2.0",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.24.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.50.0",
    "natural": "^8.1.1",
    "next": "^16.2.10",
    "next-auth": "^4.24.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.17.6",
    "tailwind-merge": "^3.6.0",
    "undici": "^8.7.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.5",
    "@types/react-dom": "^19.0.3",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.13.0",
  "overrides": {
    "fast-xml-parser": "^5.10.1",
    "sharp": "^0.35.0"
  }
}
